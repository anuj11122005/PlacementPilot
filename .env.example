# PlacementPilot — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env — it is in .gitignore.

# Postgres + pgvector connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placementpilot

# API key for your chosen LLM provider (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Embedding model identifier (e.g. text-embedding-3-small or BAAI/bge-small-en)
# See DECISIONS.md D2 for the rationale behind model choice.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Confidence score below which the LLM is NOT called — return "not enough context" instead.
# Must be a float between 0.0 and 1.0. See DECISIONS.md D4 and ARCHITECTURE.md §3.4.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.6
